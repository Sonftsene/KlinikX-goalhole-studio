# NöbetMed — Apache / Hostinger yapılandırması
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Hassas dosyalara doğrudan erişimi engelle
<FilesMatch "(^\.|\.(sqlite|sqlite-wal|sqlite-shm|db|sql|ini|log|md|bak)$|^config\.php$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Korunan klasörler
    RewriteRule ^(data|uploads|inc)(/|$) - [F,L]
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 128M
    php_value post_max_size 130M
    php_value max_execution_time 300
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
</IfModule>

# Hız: metin dosyalarını sıkıştır (JS kütüphaneleri ~%70 küçülür)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_expires.c>
    ExpiresByType application/manifest+json "access plus 7 days"
</IfModule>
<FilesMatch "\.(js|css|png|svg|woff2)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=2592000"
    </IfModule>
</FilesMatch>
# Service worker her açılışta denetlenmeli (yeni sürüm hemen gelsin)
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache"
    </IfModule>
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
</Files>
